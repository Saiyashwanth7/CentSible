# App
APP_ENV=DEVELOPMENT
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_NAME=centsible
DATABASE_PASSWORD=your-db-password
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=postgres

# Cloudflare R2 (S3-compatible object storage)
BUCKET_SECRET_KEY=your-r2-secret-access-key
BUCKET_ACCESS_KEY_ID=your-r2-access-key-id
BUCKET_NAME=centsible-receipts
BUCKET_REGION=auto
BUCKET_ENDPOINT_URL=https://<your-account-id>.r2.cloudflarestorage.com

# JWT / Auth
ACCESS_SECRET_KEY=your-access-token-secret
REFRESH_SECRET_KEY=your-refresh-token-secret
SESSION_SECRET_KEY=your-session-secret

# Google OAuth (leave blank if not using Google sign-in)
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URL=http://localhost:8000/api/v1/auth/google/callback

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Email (Brevo, leave blank if not using email delivery)
BREVO_API_KEY=
FROM_EMAIL=noreply@centsible.app


# RabbitMQ
RABBITMQ_USER=rabbitmq_user
RABBITMQ_PASSWORD=rabbitmq_password

# Celery broker
CELERY_BROKER_URL=amqp://centsible_rabbitmq:rabbitmq_password@localhost:5672//